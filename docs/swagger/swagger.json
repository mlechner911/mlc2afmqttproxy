{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/api/v1/control": {
            "get": {
                "description": "Freigegebene Geräte je Mandant, Ergebnisse seit dem Start, die letzten 200 Befehle. Nur angemeldet.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Control"
                ],
                "summary": "Rückweg (Befehle aus dem Monitor)",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/web.ControlResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/devices": {
            "get": {
                "description": "Geräte aus zigbee2mqtt mit Nachrichten heute/7/30 Tage, mittlerem Sendeabstand und Status (ok, silent, offline, unknown).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Devices"
                ],
                "summary": "Zigbee-Geräte",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/web.DevicesResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/devices/history": {
            "get": {
                "description": "Ohne from: Tageswerte der letzten `days` Tage (1–400, Standard 30). Mit from (RFC3339, to optional): Stundenwerte, höchstens 31 Tage.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Devices"
                ],
                "summary": "Verlauf eines Zigbee-Geräts",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Gerätename (friendly_name)",
                        "name": "name",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Tage",
                        "name": "days",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Beginn (RFC3339) — Stundenwerte",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Ende (RFC3339)",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/web.DeviceHistoryResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/filters": {
            "get": {
                "description": "Topic-Filter mit Treffern je Regel seit dem Start, Deduplizierung, zusätzliche Routen. Nur angemeldet.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Status"
                ],
                "summary": "Filter und Routen",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/web.FiltersResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/health": {
            "get": {
                "description": "Zeigt an, ob der Proxy läuft, und gibt die aktuelle Version aus.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Health-Check abrufen",
                "responses": {
                    "200": {
                        "description": "Erfolgreiche Antwort",
                        "schema": {
                            "$ref": "#/definitions/web.HealthResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/history": {
            "get": {
                "description": "Tageswerte der letzten `days` Tage, Summen für 1/7/30/365 Tage und die Unterbrechungen der Weiterleitung.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "History"
                ],
                "summary": "Verlauf (Tageswerte und Zeiträume)",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Tage (1–400, Standard 30)",
                        "name": "days",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/web.HistoryResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/history/detail": {
            "get": {
                "description": "Abschnitte und Zustandsintervalle in [from, to). Standard: die letzten 24 Stunden; höchstens 31 Tage.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "History"
                ],
                "summary": "Verlauf im Detail (10-Minuten-Abschnitte)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Beginn (RFC3339)",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Ende (RFC3339)",
                        "name": "to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/web.HistoryDetailResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/stats": {
            "get": {
                "description": "Gibt die Anzahl der aktuell in BadgerDB zwischengespeicherten Nachrichten zurück.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Stats"
                ],
                "summary": "Puffer-Statistik abrufen",
                "responses": {
                    "200": {
                        "description": "Erfolgreiche Antwort",
                        "schema": {
                            "$ref": "#/definitions/web.StatsResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/status": {
            "get": {
                "description": "Läuft der Proxy, leitet er weiter? Zustand, Puffer, Verbindungen, Alter der letzten Weiterleitung. Öffentlich, wenn server.public_stats (Standard).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Status"
                ],
                "summary": "Kurzstatus",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/web.StatusResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "control.Entry": {
            "type": "object",
            "properties": {
                "device": {
                    "type": "string"
                },
                "fields": {
                    "type": "object",
                    "additionalProperties": {}
                },
                "id": {
                    "type": "string"
                },
                "ieee": {
                    "type": "string"
                },
                "reason": {
                    "type": "string"
                },
                "result": {
                    "type": "string"
                },
                "tenant": {
                    "type": "string"
                },
                "time": {
                    "type": "string"
                }
            }
        },
        "history.Day": {
            "type": "object",
            "properties": {
                "buffer_max": {
                    "description": "BufferMax ist der höchste gemessene Pufferstand des Tages (Nachrichten).",
                    "type": "integer"
                },
                "date": {
                    "type": "string",
                    "example": "2026-11-25"
                },
                "dead_lettered": {
                    "type": "integer"
                },
                "deduplicated": {
                    "type": "integer"
                },
                "dropped_buffer_full": {
                    "type": "integer"
                },
                "failed": {
                    "type": "integer"
                },
                "filtered": {
                    "type": "integer"
                },
                "forwarded": {
                    "type": "integer"
                },
                "received": {
                    "type": "integer"
                },
                "stored": {
                    "type": "integer"
                }
            }
        },
        "history.DeviceTotals": {
            "type": "object",
            "properties": {
                "month": {
                    "type": "integer"
                },
                "today": {
                    "type": "integer"
                },
                "week": {
                    "type": "integer"
                }
            }
        },
        "history.Period": {
            "type": "object",
            "properties": {
                "buffer_max": {
                    "type": "integer"
                },
                "days": {
                    "type": "integer",
                    "example": 7
                },
                "dead_lettered": {
                    "type": "integer"
                },
                "deduplicated": {
                    "type": "integer"
                },
                "dropped_buffer_full": {
                    "type": "integer"
                },
                "failed": {
                    "type": "integer"
                },
                "filtered": {
                    "type": "integer"
                },
                "forwarded": {
                    "type": "integer"
                },
                "from": {
                    "type": "string",
                    "example": "2026-11-19"
                },
                "received": {
                    "type": "integer"
                },
                "seconds": {
                    "description": "Seconds je Zustand (State*) im Zeitraum; Zeit ohne Messung fehlt.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "integer",
                        "format": "int64"
                    }
                },
                "stored": {
                    "type": "integer"
                }
            }
        },
        "history.Point": {
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer"
                },
                "start": {
                    "type": "string"
                }
            }
        },
        "history.Slot": {
            "type": "object",
            "properties": {
                "buffer_max": {
                    "description": "BufferMax ist der höchste gemessene Pufferstand im Abschnitt.",
                    "type": "integer"
                },
                "dead_lettered": {
                    "type": "integer"
                },
                "deduplicated": {
                    "type": "integer"
                },
                "dropped_buffer_full": {
                    "type": "integer"
                },
                "failed": {
                    "type": "integer"
                },
                "filtered": {
                    "type": "integer"
                },
                "forwarded": {
                    "type": "integer"
                },
                "received": {
                    "type": "integer"
                },
                "start": {
                    "type": "string"
                },
                "stored": {
                    "type": "integer"
                }
            }
        },
        "history.Span": {
            "type": "object",
            "properties": {
                "end": {
                    "type": "string"
                },
                "open": {
                    "description": "Open: Der Zeitraum dauert noch an (End ist die letzte Messung).",
                    "type": "boolean"
                },
                "start": {
                    "type": "string"
                },
                "state": {
                    "type": "string",
                    "example": "upstream_down"
                }
            }
        },
        "web.ControlResponse": {
            "type": "object",
            "properties": {
                "counts": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "integer",
                        "format": "int64"
                    }
                },
                "direct": {
                    "description": "Direct: Befehle über den eigenen Broker; sonst über control.broker (z. B. Mosquitto).",
                    "type": "boolean"
                },
                "enabled": {
                    "type": "boolean"
                },
                "recent": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/control.Entry"
                    }
                },
                "tenants": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/web.ControlTenant"
                    }
                }
            }
        },
        "web.ControlTenant": {
            "type": "object",
            "properties": {
                "allowed": {
                    "description": "IEEE → Felder",
                    "type": "object",
                    "additionalProperties": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "name": {
                    "type": "string",
                    "example": "main"
                },
                "subscribe": {
                    "type": "string",
                    "example": "cmd/zb/#"
                }
            }
        },
        "web.DeviceHistoryResponse": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "points": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/history.Point"
                    }
                },
                "resolution": {
                    "description": "Resolution: \"day\" oder \"hour\".",
                    "type": "string",
                    "example": "day"
                }
            }
        },
        "web.DeviceInfo": {
            "type": "object",
            "properties": {
                "availability": {
                    "description": "Availability: online/offline laut z2m; leer, wenn z2m keine Verfügbarkeit meldet.",
                    "type": "string"
                },
                "avg_interval_s": {
                    "description": "AvgIntervalS ist der mittlere Abstand zwischen zwei Nachrichten in den letzten 7 Tagen\n(nur Laufzeit des Proxys); 0 = zu wenige Nachrichten für eine Aussage.",
                    "type": "integer"
                },
                "battery": {
                    "type": "number"
                },
                "description": {
                    "type": "string"
                },
                "ieee": {
                    "type": "string",
                    "example": "0x00158d0000000001"
                },
                "known": {
                    "description": "Known: in bridge/devices aufgeführt (sonst nur aus einem Topic erschlossen).",
                    "type": "boolean"
                },
                "last_seen": {
                    "type": "string"
                },
                "linkquality": {
                    "type": "number"
                },
                "messages": {
                    "$ref": "#/definitions/history.DeviceTotals"
                },
                "model": {
                    "type": "string"
                },
                "name": {
                    "type": "string",
                    "example": "Wohnzimmer Temperatur"
                },
                "power_source": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "example": "ok"
                },
                "type": {
                    "description": "Type: Coordinator, Router oder EndDevice (z2m).",
                    "type": "string"
                },
                "vendor": {
                    "type": "string"
                },
                "writable": {
                    "description": "Writable: per \u003cname\u003e/set schreibbare Eigenschaften laut z2m-Definition (exposes).",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "web.DevicesResponse": {
            "type": "object",
            "properties": {
                "devices": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/web.DeviceInfo"
                    }
                }
            }
        },
        "web.FiltersResponse": {
            "type": "object",
            "properties": {
                "dedup_ignore_keys": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "dedup_interval_ms": {
                    "type": "integer"
                },
                "deduplicated_total": {
                    "type": "integer"
                },
                "routes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/web.RouteInfo"
                    }
                },
                "rules": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/web.Rule"
                    }
                },
                "target": {
                    "type": "string"
                }
            }
        },
        "web.HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "description": "Status der Anwendung (normalerweise \"ok\").",
                    "type": "string"
                },
                "version": {
                    "description": "Die aktuelle Version der Proxy-Anwendung.",
                    "type": "string"
                }
            }
        },
        "web.HistoryDetailResponse": {
            "type": "object",
            "properties": {
                "from": {
                    "type": "string"
                },
                "slot_seconds": {
                    "type": "integer",
                    "example": 600
                },
                "slots": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/history.Slot"
                    }
                },
                "spans": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/history.Span"
                    }
                },
                "to": {
                    "type": "string"
                }
            }
        },
        "web.HistoryResponse": {
            "type": "object",
            "properties": {
                "daily": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/history.Day"
                    }
                },
                "days": {
                    "type": "integer",
                    "example": 30
                },
                "interruptions": {
                    "description": "Interruptions sind die Zeiträume ohne Weiterleitung im Fenster, neueste zuerst (max. 200).",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/history.Span"
                    }
                },
                "periods": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/history.Period"
                    }
                }
            }
        },
        "web.RouteInfo": {
            "type": "object",
            "properties": {
                "devices": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "name": {
                    "type": "string"
                },
                "upstream": {
                    "type": "string"
                }
            }
        },
        "web.Rule": {
            "type": "object",
            "properties": {
                "hits": {
                    "type": "integer"
                },
                "kind": {
                    "description": "Kind: allow (Topic muss mit einem dieser Präfixe beginnen) oder ignore.",
                    "type": "string",
                    "example": "ignore"
                },
                "prefix": {
                    "type": "string"
                }
            }
        },
        "web.StatsResponse": {
            "type": "object",
            "properties": {
                "buffer_count": {
                    "description": "Die aktuelle Anzahl der in BadgerDB zwischengespeicherten Nachrichten.",
                    "type": "integer"
                },
                "commands_skipped_total": {
                    "description": "Befehle an zigbee2mqtt (…/set, …/get, bridge/request) — keine Messwerte, nicht weitergeleitet.",
                    "type": "integer"
                },
                "messages_dead_lettered_total": {
                    "description": "Endgültig abgelehnt und in der Dead-Letter-Datei abgelegt (nicht weitergeleitet).",
                    "type": "integer"
                },
                "messages_deduplicated_total": {
                    "type": "integer"
                },
                "messages_dropped_buffer_full_total": {
                    "description": "Bei vollem Puffer nicht angenommen (Tail-Drop) — diese Werte fehlen im Nachweis.",
                    "type": "integer"
                },
                "messages_filtered_total": {
                    "description": "Von den Topic-Filtern (allowed_prefixes / ignored_prefixes) verworfen. Bis 25.11.2026 nicht gezählt.",
                    "type": "integer"
                },
                "messages_forward_failed_total": {
                    "type": "integer"
                },
                "messages_forwarded_total": {
                    "type": "integer"
                },
                "messages_received_total": {
                    "type": "integer"
                },
                "messages_stored_total": {
                    "type": "integer"
                }
            }
        },
        "web.StatusResponse": {
            "type": "object",
            "properties": {
                "authorized": {
                    "description": "Authorized: Diese Anfrage darf den geschützten Teil sehen (angemeldet oder lokal ohne Passwort).",
                    "type": "boolean"
                },
                "buffer_pending": {
                    "type": "integer"
                },
                "devices_public": {
                    "type": "boolean"
                },
                "last_forward_age_s": {
                    "description": "Alter in Sekunden; -1 = seit dem Start noch nie.",
                    "type": "integer"
                },
                "last_receive_age_s": {
                    "type": "integer"
                },
                "login_configured": {
                    "description": "LoginConfigured: Es gibt ein Passwort; die Live-Ansicht lässt sich anmelden.",
                    "type": "boolean"
                },
                "mode": {
                    "type": "string",
                    "example": "mqtt"
                },
                "state": {
                    "description": "State: ok, upstream_down, paused, buffer_full (wie im Verlauf).",
                    "type": "string",
                    "example": "ok"
                },
                "upstream_connected": {
                    "type": "boolean"
                },
                "uptime_s": {
                    "type": "integer"
                },
                "version": {
                    "type": "string"
                },
                "zigbee_connected": {
                    "type": "boolean"
                }
            }
        }
    }
}